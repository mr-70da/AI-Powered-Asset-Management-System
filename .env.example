# Copy to .env and fill in. Used by docker-compose.yml.
# These mirror the ASP.NET Core configuration keys (KASM__ prefix maps to appsettings sections).

# SQL Server
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
MSSQL_DB=AssetManagement
MSSQL_USER=sa

# Redis
REDIS_PORT=6379

# Application settings passed to the API container (optional)
KASM__Jwt__SigningKey=change-me-to-a-random-string-of-at-least-32-chars
KASM__Ai__Provider=stub
KASM__Ai__ApiKey=
KASM__Ai__KeyFilePath=api_keys.txt

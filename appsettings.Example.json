{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=<host>;Database=AssetManagement;User Id=<user>;Password=<password>;TrustServerCertificate=True"
  },

  "Redis": {
    "ConnectionString": "<host>:6379",
    "KeyPrefix": "kasm:",
    "LookupTtlMinutes": 60,
    "ListTtlSeconds": 60,
    "DetailTtlSeconds": 120,
    "AiAnswerTtlMinutes": 10
  },

  "CacheSettings": {
    "ConnectionString": "<host>:6379",
    "GlobalPrefix": "KinanaAssets:",
    "LookupTtlMinutes": 60,
    "AssetTtlMinutes": 15,
    "AiAnswerTtlMinutes": 10
  },

  "Jwt": {
    "Issuer": "Kinana.AssetManagement.Api",
    "Audience": "Kinana.AssetManagement.Client",
    "AccessTokenLifetimeMinutes": 30,
    "RefreshTokenLifetimeDays": 7,
    "SigningKey": "<set via dotnet user-secrets or KASM__Jwt__SigningKey env var; min 32 random bytes>"
  },

  "Ai": {
    "Provider": "stub | openai",
    "Endpoint": "https://api.openai.com/v1",
    "Model": "gpt-4o-mini",
    "ApiKey": "<set via dotnet user-secrets or KASM__Ai__ApiKey env var; never commit>",
    "KeyFilePath": "api_keys.txt",
    "TimeoutSeconds": 20,
    "MaxRows": 50,
    "MaxRequestsPerMinutePerUser": 5
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}

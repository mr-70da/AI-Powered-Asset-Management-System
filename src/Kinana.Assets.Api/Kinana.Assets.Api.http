@KinanaAssetManagement_HostAddress = http://localhost:5258
@AccessToken = <paste JWT from /api/auth/login>
@AssetId = 1

### Health (no auth)
GET {{KinanaAssetManagement_HostAddress}}/health
Accept: application/json

### Login (R1.1) - Admin
POST {{KinanaAssetManagement_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "userName": "admin",
  "password": "Admin@1234"
}

### Login - User
POST {{KinanaAssetManagement_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "userName": "user",
  "password": "User@1234"
}

### Current profile
GET {{KinanaAssetManagement_HostAddress}}/api/auth/me
Authorization: Bearer {{AccessToken}}

### Transfer an asset (R3.1, R3.3, R3.5) - Admin only
# RowVersion comes from GET /api/assets/{id}. Send back the value you received.
POST {{KinanaAssetManagement_HostAddress}}/api/assets/{{AssetId}}/transfer
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "toDepartmentId": 2,
  "toEmployeeId": 3,
  "toLocationId": 2,
  "transferDate": "2026-08-14",
  "reason": "Reassigned to the Finance team.",
  "rowVersion": "<paste RowVersion from GET /api/assets/{id}>"
}

### Transfer history (R3.2)
GET {{KinanaAssetManagement_HostAddress}}/api/assets/{{AssetId}}/transfers
Authorization: Bearer {{AccessToken}}

### AI assistant - ask a question (R4)
# Uses Ai:Provider ("stub" by default; switch to "openai" with a key to use
# the real model). The answer is grounded in the asset database (R4.4).
POST {{KinanaAssetManagement_HostAddress}}/api/ai/ask
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "question": "Show me all laptops currently assigned to the Presales department."
}

### AI assistant - count question (R4)
POST {{KinanaAssetManagement_HostAddress}}/api/ai/ask
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "question": "How many Dell laptops do we have?"
}

### AI assistant - value question (R4.3)
# As the seeded "user" account this returns the Admin-only refusal message,
# never a cost figure. Log in as "admin" to get the total instead.
POST {{KinanaAssetManagement_HostAddress}}/api/ai/ask
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "question": "What is the total purchase cost of the Dell laptops?"
}

### AI assistant - out-of-scope question (R4.5)
POST {{KinanaAssetManagement_HostAddress}}/api/ai/ask
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "question": "Tell me a joke."
}
